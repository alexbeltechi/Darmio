{
  "slug": "posts",
  "name": "Posts",
  "description": "Everything published on the site: a title plus stacked content blocks (text, galleries, video, quotes).",
  "fields": [
    {
      "key": "title",
      "type": "text",
      "required": true,
      "label": "Title",
      "placeholder": "Post title"
    },
    {
      "key": "previewImage",
      "type": "media",
      "required": false,
      "label": "Preview Image",
      "description": "Optional override for feeds and grids. Defaults to the first item of the first gallery.",
      "accept": ["image/*", "video/*"]
    },
    {
      "key": "content",
      "type": "blocks",
      "required": false,
      "label": "Content",
      "blockTypes": ["text", "gallery", "video", "youtube", "quote", "divider"]
    },
    {
      "key": "categories",
      "type": "categories",
      "required": true,
      "label": "Categories",
      "description": "Select one or more categories"
    },
    {
      "key": "date",
      "type": "datetime",
      "required": false,
      "label": "Date",
      "description": "Post date for sorting"
    },
    {
      "key": "tags",
      "type": "text",
      "required": false,
      "label": "Tags",
      "placeholder": "photography, travel, portraits"
    },
    {
      "key": "description",
      "type": "textarea",
      "required": false,
      "label": "Description",
      "placeholder": "Optional. Leave blank to use the start of the text.",
      "description": "Shown under the post in feeds, in place of the start of its text"
    },
    {
      "key": "sourceLabel",
      "type": "text",
      "required": false,
      "label": "Source",
      "description": "Shown at the end of the post as \"Source: X\". Presets are edited in Settings."
    },
    {
      "key": "sourceUrl",
      "type": "text",
      "required": false,
      "label": "Source link",
      "placeholder": "https://x.com/..."
    },
    {
      "key": "docs",
      "type": "docs",
      "required": false,
      "label": "Docs",
      "description": "Markdown briefs and sources that guide this post (admin › Agent)"
    }
  ],
  "admin": {
    "titleField": "title",
    "thumbnailField": "previewImage",
    "defaultSort": {
      "field": "date",
      "direction": "desc"
    }
  }
}
