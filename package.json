{
  "name": "darmio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:parabola": "npx tsx scripts/check-parabola-tokens.ts",
    "check:leaks": "npx tsx scripts/check-leaks.ts",
    "reset-password": "npx tsx scripts/reset-password.ts",
    "reset-link": "npx tsx scripts/reset-link.ts",
    "seed": "npx tsx scripts/seed.ts",
    "verify": "next typegen && tsc --noEmit && eslint . --max-warnings 0 && npm run check:parabola && npm run check:leaks && npm test && next build",
    "test": "node scripts/run-tests.mjs"
  },
