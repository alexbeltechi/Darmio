# Copy to .env.local and fill in. Never commit .env.local.

# The database. Any MongoDB works; Atlas's free tier is fine.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The database's name (without it, MongoDB uses one called "test").
MONGODB_DB=darmio-dev

# Sign-in. The site's own address, and a long random secret
# (make one with: openssl rand -base64 32).
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=

# A one-time code for the first setup: open /admin/setup?code=<SETUP_CODE>.
# 16 characters or more.
SETUP_CODE=

# Lets an AI use the site's API (send it as a Bearer token).
CMS_AGENT_TOKEN=

# Optional: where uploads go. Without it, uploads are saved in public/uploads/.
# BLOB_READ_WRITE_TOKEN=

# Optional: your site's public address, when it differs from NEXTAUTH_URL.
# SITE_URL=
